{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "prisma/**",
          "node_modules/.prisma/client/**",
          "node_modules/@prisma/client/**",
          "node_modules/@aws-sdk/**",
          "node_modules/@aws-crypto/**",
          "node_modules/@smithy/**",
          "node_modules/tslib/**",
          "node_modules/uuid/**",
          "node_modules/fast-xml-parser/**",
          "node_modules/bowser/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/docs(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
