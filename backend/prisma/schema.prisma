generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String         @id @default(cuid())
  name          String
  username      String?        @unique
  email         String         @unique
  mobile        String?
  passwordHash  String         @map("password_hash")
  roleId        String         @map("role_id")
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  assetAssignmentsAssigned AssetAssignment[] @relation("AssetAssignmentAssignedBy")
  assetHistoriesCreated    AssetHistory[]    @relation("AssetHistoryCreatedBy")
  tripsCreated             Trip[]            @relation("TripCreatedBy")
  tripHistoriesCreated     TripHistory[]     @relation("TripHistoryCreatedBy")
  fuelEntriesCreated       FuelEntry[]       @relation("FuelCreatedBy")
  fuelEntriesApproved      FuelEntry[]       @relation("FuelApprovedBy")
  expensesCreated          Expense[]         @relation("ExpenseCreatedBy")
  expensesApproved         Expense[]         @relation("ExpenseApprovedBy")
  maintenanceCreated       MaintenanceRequest[] @relation("MaintenanceCreatedBy")
  maintenanceApproved      MaintenanceRequest[] @relation("MaintenanceApprovedBy")
  repairsCreated           Repair[]          @relation("RepairCreatedBy")
  repairsClosed            Repair[]          @relation("RepairClosedBy")
  complianceDocsVerified   VehicleComplianceDocument[] @relation("ComplianceDocVerifiedBy")
  complianceHistoryCreated VehicleComplianceHistory[]  @relation("ComplianceHistoryCreatedBy")

  @@map("users")
}

model Role {
  id              String           @id @default(cuid())
  name            String
  key             String           @unique
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  status          RoleStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  UNDER_MAINTENANCE
  UNDER_REPAIR
  INACTIVE
  SOLD
  ACCIDENT
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

enum AssetCategoryStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  DAMAGED
  LOST
  UNDER_REPAIR
  RETIRED
}

enum AssetAssignmentHolderType {
  VEHICLE
  DRIVER
  USER
}

enum AssetAssignmentStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
  DAMAGED
  LOST
}

enum AssetHistoryAction {
  CREATED
  UPDATED
  ASSIGNED
  RETURNED
  TRANSFERRED
  DAMAGED
  LOST
  REPAIRED
  RETIRED
}

enum TripStatus {
  DRAFT
  SCHEDULED
  STARTED
  COMPLETED
  CANCELLED
}

enum TripType {
  TRANSFER
  DELIVERY
  PICKUP
  SERVICE
  INTERNAL
}

enum TripHistoryAction {
  CREATED
  UPDATED
  SCHEDULED
  STARTED
  COMPLETED
  CANCELLED
  VEHICLE_CHANGED
  DRIVER_CHANGED
}

enum DocumentEntityType {
  VEHICLE
  DRIVER
  ASSET
}

model Vehicle {
  id              String        @id @default(cuid())
  vehicleNumber   String        @unique @map("vehicle_number")
  vehicleType     String        @map("vehicle_type")
  brand           String?
  model           String?
  year            Int?
  fuelType        String        @map("fuel_type")
  chassisNumber   String?       @unique @map("chassis_number")
  engineNumber    String?       @unique @map("engine_number")
  rcNumber        String?       @map("rc_number")
  insuranceExpiry DateTime?     @map("insurance_expiry")
  fitnessExpiry   DateTime?     @map("fitness_expiry")
  pollutionExpiry DateTime?     @map("pollution_expiry")
  permitExpiry    DateTime?     @map("permit_expiry")
  currentOdometer Int           @default(0) @map("current_odometer")
  status          VehicleStatus @default(AVAILABLE)
  currentDriverId String?       @map("current_driver_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  currentDriver   Driver?              @relation(fields: [currentDriverId], references: [id])
  trips           Trip[]
  fuelEntries     FuelEntry[]
  expenses        Expense[]
  maintenance     MaintenanceRequest[]
  repairs         Repair[]
  registrationDetail    VehicleRegistrationDetail?
  insuranceDetails      VehicleInsuranceDetail[]
  permitDetails         VehiclePermitDetail[]
  fitnessDetails        VehicleFitnessDetail[]
  pucDetails            VehiclePucDetail[]
  roadTaxDetails        VehicleRoadTaxDetail[]
  fastagDetail          VehicleFastagDetail?
  gpsDeviceDetail       VehicleGpsDeviceDetail?
  complianceDocuments   VehicleComplianceDocument[]
  complianceHistory     VehicleComplianceHistory[]

  @@map("vehicles")
}

model Driver {
  id                String       @id @default(cuid())
  name              String
  mobile            String       @unique
  alternateMobile   String?      @map("alternate_mobile")
  licenseNumber     String       @unique @map("license_number")
  licenseExpiry     DateTime?    @map("license_expiry")
  address           String?
  emergencyContact  String?      @map("emergency_contact")
  experienceYears   Int?         @map("experience_years")
  status            DriverStatus @default(AVAILABLE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  vehicles          Vehicle[]
  tripsAsDriver     Trip[]
  tripsAsAssistant  Trip[]               @relation("TripAssistantDriver")
  fuelEntries       FuelEntry[]
  expenses          Expense[]
  maintenance       MaintenanceRequest[]
  repairs           Repair[]

  @@map("drivers")
}

model AssetCategory {
  id          String             @id @default(cuid())
  name        String
  key         String             @unique
  description String?
  status      AssetCategoryStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  assets      Asset[]

  @@map("asset_categories")
}

model Asset {
  id              String      @id @default(cuid())
  assetCode       String      @unique @map("asset_code")
  name            String
  assetCategoryId String      @map("asset_category_id")
  serialNumber    String?     @unique @map("serial_number")
  purchaseDate    DateTime?   @map("purchase_date")
  purchaseAmount  Decimal?    @map("purchase_amount")
  currentStatus   AssetStatus @default(AVAILABLE) @map("current_status")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  assetCategory   AssetCategory @relation(fields: [assetCategoryId], references: [id])
  assignments     AssetAssignment[]
  history         AssetHistory[]

  @@map("assets")
}

model AssetAssignment {
  id             String                    @id @default(cuid())
  assetId        String                    @map("asset_id")
  assignedToType AssetAssignmentHolderType @map("assigned_to_type")
  assignedToId   String                    @map("assigned_to_id")
  assignedById   String?                   @map("assigned_by_id")
  assignedAt     DateTime                  @default(now()) @map("assigned_at")
  returnedAt     DateTime?                 @map("returned_at")
  status         AssetAssignmentStatus     @default(ACTIVE)
  notes          String?
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  asset          Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedBy     User?                     @relation("AssetAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([assetId, status])
  @@map("asset_assignments")
}

model AssetHistory {
  id             String                    @id @default(cuid())
  assetId        String                    @map("asset_id")
  action         AssetHistoryAction
  fromHolderType AssetAssignmentHolderType? @map("from_holder_type")
  fromHolderId   String?                   @map("from_holder_id")
  toHolderType   AssetAssignmentHolderType? @map("to_holder_type")
  toHolderId     String?                   @map("to_holder_id")
  remarks        String?
  proofUrl       String?                   @map("proof_url")
  createdById    String?                   @map("created_by_id")
  createdAt      DateTime                  @default(now()) @map("created_at")
  asset          Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy      User?                     @relation("AssetHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@map("asset_history")
}

model Trip {
  id                String      @id @default(cuid())
  tripNumber        String      @unique @map("trip_number")
  tripType          TripType    @map("trip_type")
  status            TripStatus  @default(DRAFT)
  vehicleId         String      @map("vehicle_id")
  driverId          String?     @map("driver_id")
  assistantDriverId String?     @map("assistant_driver_id")
  originName        String      @map("origin_name")
  originAddress     String?     @map("origin_address")
  destinationName   String      @map("destination_name")
  destinationAddress String?   @map("destination_address")
  plannedStartAt    DateTime?   @map("planned_start_at")
  actualStartAt     DateTime?   @map("actual_start_at")
  plannedEndAt      DateTime?   @map("planned_end_at")
  actualEndAt       DateTime?   @map("actual_end_at")
  startOdometer     Int?        @map("start_odometer")
  endOdometer       Int?        @map("end_odometer")
  distanceKm        Int?        @map("distance_km")
  purpose           String?
  notes             String?
  createdById       String?     @map("created_by_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  vehicle           Vehicle     @relation(fields: [vehicleId], references: [id])
  driver            Driver?     @relation(fields: [driverId], references: [id])
  assistantDriver   Driver?     @relation("TripAssistantDriver", fields: [assistantDriverId], references: [id])
  createdBy         User?       @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  history           TripHistory[]
  fuelEntries       FuelEntry[]
  expenses          Expense[]
  maintenance       MaintenanceRequest[]
  repairs           Repair[]

  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([status])
  @@map("trips")
}

model TripHistory {
  id          String           @id @default(cuid())
  tripId      String           @map("trip_id")
  action      TripHistoryAction
  fromStatus  TripStatus?      @map("from_status")
  toStatus    TripStatus?      @map("to_status")
  remarks     String?
  metadata    Json?
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("TripHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@map("trip_history")
}

enum WorkflowRecordStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RepairStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model FuelEntry {
  id               String               @id @default(cuid())
  vehicleId        String               @map("vehicle_id")
  tripId           String?              @map("trip_id")
  driverId         String?              @map("driver_id")
  fuelDate         DateTime             @map("fuel_date")
  odometerReading  Int?                 @map("odometer_reading")
  fuelType         String               @map("fuel_type")
  quantityLiters   Decimal              @map("quantity_liters") @db.Decimal(12, 3)
  pricePerLiter    Decimal              @map("price_per_liter") @db.Decimal(12, 2)
  totalAmount      Decimal              @map("total_amount") @db.Decimal(14, 2)
  stationName      String?              @map("station_name")
  receiptNumber    String?              @map("receipt_number")
  notes            String?
  status           WorkflowRecordStatus @default(DRAFT)
  createdById      String?              @map("created_by")
  approvedById     String?              @map("approved_by")
  approvedAt       DateTime?            @map("approved_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  vehicle          Vehicle              @relation(fields: [vehicleId], references: [id])
  trip             Trip?                @relation(fields: [tripId], references: [id])
  driver           Driver?              @relation(fields: [driverId], references: [id])
  createdBy        User?                @relation("FuelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy       User?                @relation("FuelApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([vehicleId, fuelDate])
  @@index([tripId])
  @@index([driverId])
  @@index([status])
  @@map("fuel_entries")
}

model Expense {
  id            String               @id @default(cuid())
  vehicleId     String               @map("vehicle_id")
  tripId        String?              @map("trip_id")
  driverId      String?              @map("driver_id")
  category      String
  expenseDate   DateTime             @map("expense_date")
  amount        Decimal              @db.Decimal(14, 2)
  vendor        String?
  receiptNumber String?              @map("receipt_number")
  notes         String?
  status        WorkflowRecordStatus @default(DRAFT)
  createdById   String?              @map("created_by")
  approvedById  String?              @map("approved_by")
  approvedAt    DateTime?            @map("approved_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  vehicle       Vehicle              @relation(fields: [vehicleId], references: [id])
  trip          Trip?                @relation(fields: [tripId], references: [id])
  driver        Driver?              @relation(fields: [driverId], references: [id])
  createdBy     User?                @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy    User?                @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([vehicleId, expenseDate])
  @@index([tripId])
  @@index([driverId])
  @@index([status])
  @@map("expenses")
}

model Document {
  id             String             @id @default(cuid())
  entityType     DocumentEntityType @map("entity_type")
  entityId       String             @map("entity_id")
  documentType   String             @map("document_type")
  documentNumber String?            @map("document_number")
  expiryDate     DateTime?          @map("expiry_date")
  fileUrl        String?            @map("file_url")
  fileName       String?            @map("file_name")
  mimeType       String?            @map("mime_type")
  sizeBytes      Int?               @map("size_bytes")
  uploadedById   String?            @map("uploaded_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@map("documents")
}

model MaintenanceRequest {
  id              String               @id @default(cuid())
  vehicleId       String               @map("vehicle_id")
  tripId          String?              @map("trip_id")
  driverId        String?              @map("driver_id")
  requestDate     DateTime             @map("request_date")
  priority        MaintenancePriority  @default(MEDIUM)
  category        String
  description     String
  estimatedCost   Decimal?             @map("estimated_cost") @db.Decimal(14, 2)
  actualCost      Decimal?             @map("actual_cost") @db.Decimal(14, 2)
  scheduledDate   DateTime?            @map("scheduled_date")
  completedDate   DateTime?            @map("completed_date")
  notes           String?
  status          WorkflowRecordStatus @default(DRAFT)
  createdById     String?              @map("created_by")
  approvedById    String?              @map("approved_by")
  approvedAt      DateTime?            @map("approved_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  vehicle         Vehicle              @relation(fields: [vehicleId], references: [id])
  trip            Trip?                @relation(fields: [tripId], references: [id])
  driver          Driver?              @relation(fields: [driverId], references: [id])
  createdBy       User?                @relation("MaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy      User?                @relation("MaintenanceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([vehicleId, requestDate])
  @@index([tripId])
  @@index([driverId])
  @@index([status])
  @@map("maintenance_requests")
}

model Repair {
  id              String        @id @default(cuid())
  vehicleId       String        @map("vehicle_id")
  tripId          String?       @map("trip_id")
  driverId        String?       @map("driver_id")
  repairDate      DateTime      @map("repair_date")
  category        String
  description     String
  estimatedCost   Decimal?      @map("estimated_cost") @db.Decimal(14, 2)
  actualCost      Decimal?      @map("actual_cost") @db.Decimal(14, 2)
  provider        String?
  invoiceNumber   String?       @map("invoice_number")
  notes           String?
  status          RepairStatus  @default(OPEN)
  createdById     String?       @map("created_by")
  closedById      String?       @map("closed_by")
  closedAt        DateTime?     @map("closed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  trip            Trip?         @relation(fields: [tripId], references: [id])
  driver          Driver?       @relation(fields: [driverId], references: [id])
  createdBy       User?         @relation("RepairCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy        User?         @relation("RepairClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([vehicleId, repairDate])
  @@index([tripId])
  @@index([driverId])
  @@index([status])
  @@map("repairs")
}

// ─── Phase 6.1: India Vehicle Compliance & Document Metadata ───

enum InsurancePolicyType {
  THIRD_PARTY
  COMPREHENSIVE
  OWN_DAMAGE
  PACKAGE
}

enum PermitType {
  NATIONAL
  STATE
  GOODS_CARRIAGE
  CONTRACT_CARRIAGE
  TOURIST
  STAGE_CARRIAGE
  PRIVATE_SERVICE
  OTHER
}

enum EmissionNorm {
  BSIII
  BSIV
  BSVI
  OTHER
}

enum RoadTaxType {
  LIFETIME
  ANNUAL
  QUARTERLY
  MONTHLY
  OTHER
}

enum FastagStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  LOW_BALANCE
  CLOSED
}

enum GpsDeviceStatus {
  ACTIVE
  INACTIVE
  FAULTY
  REMOVED
}

enum ComplianceType {
  RC
  INSURANCE
  PERMIT
  FITNESS
  PUC
  ROAD_TAX
  FASTAG
  GPS_AIS140
  HYPOTHECATION
  OTHER
}

enum ComplianceDocStatus {
  DRAFT
  ACTIVE
  EXPIRED
  RENEWAL_DUE
  VERIFIED
  REJECTED
}

enum ComplianceHistoryAction {
  CREATED
  UPDATED
  RENEWED
  VERIFIED
  EXPIRED
  REMINDER_DUE
  DOCUMENT_LINKED
  STATUS_CHANGED
  DELETED
}

model VehicleRegistrationDetail {
  id                String   @id @default(cuid())
  vehicleId         String   @unique @map("vehicle_id")
  registrationNumber String? @map("registration_number")
  registrationDate  DateTime? @map("registration_date")
  ownerName         String?  @map("owner_name")
  rtoCode           String?  @map("rto_code")
  rtoName           String?  @map("rto_name")
  vehicleClass      String?  @map("vehicle_class")
  transportCategory String?  @map("transport_category")
  bodyType          String?  @map("body_type")
  seatingCapacity   Int?     @map("seating_capacity")
  grossVehicleWeight Int?    @map("gross_vehicle_weight")
  unladenWeight     Int?     @map("unladen_weight")
  hypothecationName String?  @map("hypothecation_name")
  hypothecationType String?  @map("hypothecation_type")
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_registration_details")
}

model VehicleInsuranceDetail {
  id                  String              @id @default(cuid())
  vehicleId           String              @map("vehicle_id")
  policyNumber        String              @map("policy_number")
  insurerName         String              @map("insurer_name")
  policyType          InsurancePolicyType @map("policy_type")
  validFrom           DateTime            @map("valid_from")
  validTo             DateTime            @map("valid_to")
  premiumAmount       Decimal?            @map("premium_amount") @db.Decimal(14, 2)
  idvAmount           Decimal?            @map("idv_amount") @db.Decimal(14, 2)
  renewalReminderDays Int?                @default(30) @map("renewal_reminder_days")
  status              ComplianceDocStatus @default(ACTIVE)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([validTo])
  @@index([status])
  @@map("vehicle_insurance_details")
}

model VehiclePermitDetail {
  id                  String              @id @default(cuid())
  vehicleId           String              @map("vehicle_id")
  permitNumber        String              @map("permit_number")
  permitType          PermitType          @map("permit_type")
  issuingAuthority    String?             @map("issuing_authority")
  coveredStates       String?             @map("covered_states")
  coveredRoutes       String?             @map("covered_routes")
  validFrom           DateTime            @map("valid_from")
  validTo             DateTime            @map("valid_to")
  renewalReminderDays Int?                @default(30) @map("renewal_reminder_days")
  status              ComplianceDocStatus @default(ACTIVE)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([validTo])
  @@index([status])
  @@map("vehicle_permit_details")
}

model VehicleFitnessDetail {
  id                  String              @id @default(cuid())
  vehicleId           String              @map("vehicle_id")
  certificateNumber   String              @map("certificate_number")
  inspectionDate      DateTime            @map("inspection_date")
  validFrom           DateTime            @map("valid_from")
  validTo             DateTime            @map("valid_to")
  inspectionCenter    String?             @map("inspection_center")
  remarks             String?
  renewalReminderDays Int?                @default(30) @map("renewal_reminder_days")
  status              ComplianceDocStatus @default(ACTIVE)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([validTo])
  @@index([status])
  @@map("vehicle_fitness_details")
}

model VehiclePucDetail {
  id                  String              @id @default(cuid())
  vehicleId           String              @map("vehicle_id")
  certificateNumber   String              @map("certificate_number")
  emissionNorm        EmissionNorm        @map("emission_norm")
  testingCenter       String?             @map("testing_center")
  validFrom           DateTime            @map("valid_from")
  validTo             DateTime            @map("valid_to")
  renewalReminderDays Int?                @default(30) @map("renewal_reminder_days")
  status              ComplianceDocStatus @default(ACTIVE)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([validTo])
  @@index([status])
  @@map("vehicle_puc_details")
}

