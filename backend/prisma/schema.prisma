generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String         @id @default(cuid())
  name          String
  username      String?        @unique
  email         String         @unique
  mobile        String?
  passwordHash  String         @map("password_hash")
  roleId        String         @map("role_id")
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  assetAssignmentsAssigned AssetAssignment[] @relation("AssetAssignmentAssignedBy")
  assetHistoriesCreated    AssetHistory[]    @relation("AssetHistoryCreatedBy")
  tripsCreated             Trip[]            @relation("TripCreatedBy")
  tripHistoriesCreated     TripHistory[]     @relation("TripHistoryCreatedBy")
  fuelEntriesCreated       FuelEntry[]       @relation("FuelCreatedBy")
  fuelEntriesApproved      FuelEntry[]       @relation("FuelApprovedBy")
  expensesCreated          Expense[]         @relation("ExpenseCreatedBy")
  expensesApproved         Expense[]         @relation("ExpenseApprovedBy")
  maintenanceCreated       MaintenanceRequest[] @relation("MaintenanceCreatedBy")
  maintenanceApproved      MaintenanceRequest[] @relation("MaintenanceApprovedBy")
  repairsCreated           Repair[]          @relation("RepairCreatedBy")
  repairsClosed            Repair[]          @relation("RepairClosedBy")
  complianceDocsVerified   VehicleComplianceDocument[] @relation("ComplianceDocVerifiedBy")
  complianceHistoryCreated VehicleComplianceHistory[]  @relation("ComplianceHistoryCreatedBy")
  tripBillingsCreated      TripBilling[]               @relation("TripBillingCreatedBy")
  tripBillingsUpdated      TripBilling[]               @relation("TripBillingUpdatedBy")
  financeTxnsCreated       FinanceTransaction[]        @relation("FinanceTxnCreatedBy")
  financeTxnsUpdated       FinanceTransaction[]        @relation("FinanceTxnUpdatedBy")
  paymentsCreated          PaymentRecord[]             @relation("PaymentRecordCreatedBy")
  financeHistoryCreated    FinanceHistory[]            @relation("FinanceHistoryCreatedBy")
  uploadedDocuments        Document[]                  @relation("DocumentUploadedBy")
  verifiedDocuments        Document[]                  @relation("DocumentVerifiedBy")
  permissionOverrides      UserPermissionOverride[]     @relation("UserPermissionOverrides")
  permissionOverridesGranted UserPermissionOverride[]   @relation("PermissionOverridesGrantedBy")
  dataScopes               UserDataScope[]              @relation("UserDataScopes")
  dataScopesGranted        UserDataScope[]              @relation("DataScopesGrantedBy")

  @@map("users")
}

model Role {
  id              String           @id @default(cuid())
  name            String
  key             String           @unique
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  status          RoleStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions        RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id           String                   @id @default(cuid())
  userId       String                   @map("user_id")
  permissionId String                   @map("permission_id")
  effect       PermissionOverrideEffect
  reason       String?
  expiresAt    DateTime?                @map("expires_at")
  grantedById  String?                  @map("granted_by_id")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  user         User                     @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission               @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy    User?                    @relation("PermissionOverridesGrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model UserDataScope {
  id          String               @id @default(cuid())
  userId      String               @map("user_id")
  scopeType   DataScopeType        @map("scope_type")
  scopeId     String?              @map("scope_id")
  accessLevel DataScopeAccessLevel @map("access_level")
  reason      String?
  expiresAt   DateTime?            @map("expires_at")
  grantedById String?              @map("granted_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user        User                 @relation("UserDataScopes", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?                @relation("DataScopesGrantedBy", fields: [grantedById], references: [id])

  @@index([userId, scopeType, scopeId])
  @@map("user_data_scopes")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum PermissionOverrideEffect {
  ALLOW
  DENY
}

enum DataScopeType {
  OWN
  USER
  DRIVER
  VEHICLE
  TRIP
  ASSET
  CUSTOMER
  VENDOR
  BRANCH
  DEPARTMENT
  FINANCE
  GLOBAL
}

enum DataScopeAccessLevel {
  VIEW
  CREATE
  UPDATE
  DELETE
  MANAGE
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  UNDER_MAINTENANCE
  UNDER_REPAIR
  INACTIVE
  SOLD
  ACCIDENT
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

enum AssetCategoryStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  DAMAGED
  LOST
  UNDER_REPAIR
  RETIRED
}

enum AssetAssignmentHolderType {
  VEHICLE
  DRIVER
  USER
}

enum AssetAssignmentStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
  DAMAGED
  LOST
}

enum AssetHistoryAction {
  CREATED
  UPDATED
  ASSIGNED
  RETURNED
  TRANSFERRED
  DAMAGED
  LOST
  REPAIRED
  RETIRED
}

enum TripStatus {
  DRAFT
  SCHEDULED
  STARTED
  COMPLETED
  CANCELLED
}

enum TripType {
  TRANSFER
  DELIVERY
  PICKUP
  SERVICE
  INTERNAL
}

enum TripHistoryAction {
  CREATED
  UPDATED
  SCHEDULED
  STARTED
  COMPLETED
  CANCELLED
  VEHICLE_CHANGED
  DRIVER_CHANGED
}

enum DocumentEntityType {
  VEHICLE
  DRIVER
  ASSET
}

enum DocumentType {
  VEHICLE_RC
  VEHICLE_INSURANCE
  VEHICLE_PERMIT
  VEHICLE_FITNESS
  VEHICLE_PUC
  ROAD_TAX
  FASTAG
  AIS140_GPS
  DRIVER_LICENSE
  DRIVER_ID_PROOF
  TRIP_POD
  TRIP_CHALLAN
  TRIP_LR
  TRIP_EWAY_BILL
  CUSTOMER_PO
  INVOICE
  PAYMENT_PROOF
  FUEL_BILL
  EXPENSE_BILL
  MAINTENANCE_BILL
  REPAIR_BILL
  VENDOR_DOCUMENT
  CUSTOMER_DOCUMENT
  GENERAL
}

enum DocumentCategory {
  VEHICLE
  DRIVER
  TRIP
  COMPLIANCE
  FINANCE
  MAINTENANCE
  REPAIR
  VENDOR
  CUSTOMER
  GENERAL
}

enum LinkedEntityType {
  VEHICLE
  DRIVER
  TRIP
  CUSTOMER
  VENDOR
  FINANCE_TRANSACTION
  TRIP_BILLING
  MAINTENANCE_REQUEST
  REPAIR
  FUEL_ENTRY
  GENERAL
}

enum FuelEntryMode {
  QUICK_AMOUNT
  FULL_DETAILS
  RECEIPT_ASSISTED
}

enum ExtractionStatus {
  NOT_REQUIRED
  PENDING
  EXTRACTED
  CONFIRMED
  FAILED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Vehicle {
  id              String        @id @default(cuid())
  vehicleNumber   String        @unique @map("vehicle_number")
  vehicleType     String        @map("vehicle_type")
  brand           String?
  model           String?
  year            Int?
  fuelType        String        @map("fuel_type")
  chassisNumber   String?       @unique @map("chassis_number")
  engineNumber    String?       @unique @map("engine_number")
  rcNumber        String?       @map("rc_number")
  insuranceExpiry DateTime?     @map("insurance_expiry")
  fitnessExpiry   DateTime?     @map("fitness_expiry")
  pollutionExpiry DateTime?     @map("pollution_expiry")
  permitExpiry    DateTime?     @map("permit_expiry")
  currentOdometer Int           @default(0) @map("current_odometer")
  status          VehicleStatus @default(AVAILABLE)
  currentDriverId String?       @map("current_driver_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  currentDriver   Driver?              @relation(fields: [currentDriverId], references: [id])
  trips           Trip[]
  fuelEntries     FuelEntry[]
  expenses        Expense[]
  maintenance       MaintenanceRequest[]
  repairs           Repair[]
  financeTransactions FinanceTransaction[]
  tripBillings        TripBilling[]
  registrationDetail    VehicleRegistrationDetail?
  insuranceDetails      VehicleInsuranceDetail[]
  permitDetails         VehiclePermitDetail[]
  fitnessDetails        VehicleFitnessDetail[]
  pucDetails            VehiclePucDetail[]
  roadTaxDetails        VehicleRoadTaxDetail[]
  fastagDetail          VehicleFastagDetail?
  gpsDeviceDetail       VehicleGpsDeviceDetail?
  complianceDocuments   VehicleComplianceDocument[]
  complianceHistory     VehicleComplianceHistory[]
  documents             Document[]

  @@map("vehicles")
}

model Driver {
  id                String       @id @default(cuid())
  name              String
  mobile            String       @unique
  alternateMobile   String?      @map("alternate_mobile")
  licenseNumber     String       @unique @map("license_number")
  licenseExpiry     DateTime?    @map("license_expiry")
  address           String?
  emergencyContact  String?      @map("emergency_contact")
  experienceYears   Int?         @map("experience_years")
  status            DriverStatus @default(AVAILABLE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  vehicles          Vehicle[]
  tripsAsDriver     Trip[]
  tripsAsAssistant  Trip[]               @relation("TripAssistantDriver")
  fuelEntries       FuelEntry[]
  expenses          Expense[]
  maintenance       MaintenanceRequest[]
  repairs           Repair[]
  financeTransactions FinanceTransaction[]
  tripBillings        TripBilling[]
  documents           Document[]

  @@map("drivers")
}

model AssetCategory {
  id          String             @id @default(cuid())
  name        String
  key         String             @unique
  description String?
  status      AssetCategoryStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  assets      Asset[]

  @@map("asset_categories")
}

model Asset {
  id              String      @id @default(cuid())
  assetCode       String      @unique @map("asset_code")
  name            String
  assetCategoryId String      @map("asset_category_id")
  serialNumber    String?     @unique @map("serial_number")
  purchaseDate    DateTime?   @map("purchase_date")
  purchaseAmount  Decimal?    @map("purchase_amount")
  currentStatus   AssetStatus @default(AVAILABLE) @map("current_status")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  assetCategory   AssetCategory @relation(fields: [assetCategoryId], references: [id])
  assignments     AssetAssignment[]
  history         AssetHistory[]

  @@map("assets")
}

model AssetAssignment {
  id             String                    @id @default(cuid())
  assetId        String                    @map("asset_id")
  assignedToType AssetAssignmentHolderType @map("assigned_to_type")
  assignedToId   String                    @map("assigned_to_id")
  assignedById   String?                   @map("assigned_by_id")
  assignedAt     DateTime                  @default(now()) @map("assigned_at")
  returnedAt     DateTime?                 @map("returned_at")
  status         AssetAssignmentStatus     @default(ACTIVE)
  notes          String?
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  asset          Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedBy     User?                     @relation("AssetAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([assetId, status])
  @@map("asset_assignments")
}

model AssetHistory {
  id             String                    @id @default(cuid())
  assetId        String                    @map("asset_id")
  action         AssetHistoryAction
  fromHolderType AssetAssignmentHolderType? @map("from_holder_type")
  fromHolderId   String?                   @map("from_holder_id")
  toHolderType   AssetAssignmentHolderType? @map("to_holder_type")
  toHolderId     String?                   @map("to_holder_id")
  remarks        String?
  proofUrl       String?                   @map("proof_url")
  createdById    String?                   @map("created_by_id")
  createdAt      DateTime                  @default(now()) @map("created_at")
  asset          Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy      User?                     @relation("AssetHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@map("asset_history")
}

model Trip {
  id                String      @id @default(cuid())
  tripNumber        String      @unique @map("trip_number")
  tripType          TripType    @map("trip_type")
  status            TripStatus  @default(DRAFT)
  vehicleId         String      @map("vehicle_id")
  driverId          String?     @map("driver_id")
  assistantDriverId String?     @map("assistant_driver_id")
  originName        String      @map("origin_name")
  originAddress     String?     @map("origin_address")
  destinationName   String      @map("destination_name")
  destinationAddress String?   @map("destination_address")
  plannedStartAt    DateTime?   @map("planned_start_at")
  actualStartAt     DateTime?   @map("actual_start_at")
  plannedEndAt      DateTime?   @map("planned_end_at")
  actualEndAt       DateTime?   @map("actual_end_at")
  startOdometer     Int?        @map("start_odometer")
  endOdometer       Int?        @map("end_odometer")
  distanceKm        Int?        @map("distance_km")
  purpose           String?
  notes             String?
  createdById       String?     @map("created_by_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  vehicle           Vehicle     @relation(fields: [vehicleId], references: [id])
  driver            Driver?     @relation(fields: [driverId], references: [id])
  assistantDriver   Driver?     @relation("TripAssistantDriver", fields: [assistantDriverId], references: [id])
  createdBy         User?       @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  history           TripHistory[]
  fuelEntries       FuelEntry[]
  expenses          Expense[]
  maintenance       MaintenanceRequest[]
  repairs           Repair[]
  billing           TripBilling?
  financeTransactions FinanceTransaction[]
  documents           Document[]

  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([status])
  @@map("trips")
}

model TripHistory {
  id          String           @id @default(cuid())
  tripId      String           @map("trip_id")
  action      TripHistoryAction
  fromStatus  TripStatus?      @map("from_status")
  toStatus    TripStatus?      @map("to_status")
  remarks     String?
  metadata    Json?
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("TripHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@map("trip_history")
}

enum WorkflowRecordStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RepairStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model FuelEntry {
  id                   String               @id @default(cuid())
  vehicleId            String               @map("vehicle_id")
  tripId               String?              @map("trip_id")
  driverId             String?              @map("driver_id")
  fuelDate             DateTime             @map("fuel_date")
  odometerReading      Int?                 @map("odometer_reading")
  fuelType             String               @map("fuel_type")
  entryMode            FuelEntryMode        @default(FULL_DETAILS) @map("entry_mode")
  quantityLiters       Decimal?             @map("quantity_liters") @db.Decimal(12, 3)
  pricePerLiter        Decimal?             @map("price_per_liter") @db.Decimal(12, 2)
  totalAmount          Decimal              @map("total_amount") @db.Decimal(14, 2)
  stationName          String?              @map("station_name")
  receiptNumber        String?              @map("receipt_number")
  paymentMode          String?              @map("payment_mode")
  extractionStatus     ExtractionStatus     @default(NOT_REQUIRED) @map("extraction_status")
  extractionConfidence Decimal?             @map("extraction_confidence") @db.Decimal(5, 4)
  extractionRawText    String?              @map("extraction_raw_text") @db.Text
  notes                String?
  status               WorkflowRecordStatus @default(DRAFT)
  createdById          String?              @map("created_by")
  approvedById         String?              @map("approved_by")
  approvedAt           DateTime?            @map("approved_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  vehicle              Vehicle              @relation(fields: [vehicleId], references: [id])
  trip                 Trip?                @relation(fields: [tripId], references: [id])
  driver               Driver?              @relation(fields: [driverId], references: [id])
  createdBy            User?                @relation("FuelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy           User?                @relation("FuelApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  documents            Document[]           @relation("FuelLinkedDocuments")

  @@index([vehicleId, fuelDate])
  @@index([tripId])
  @@index([driverId])
  @@index([status])
  @@map("fuel_entries")
}

model Expense {
  id            String               @id @default(cuid())
  vehicleId     String               @map("vehicle_id")
  tripId        String?              @map("trip_id")
  driverId      String?              @map("driver_id")
  category      String
  expenseDate   DateTime             @map("expense_date")
  amount        Decimal              @db.Decimal(14, 2)
  vendor        String?
  receiptNumber String?              @map("receipt_number")
  notes         String?
  status        WorkflowRecordStatus @default(DRAFT)
  createdById   String?              @map("created_by")
  approvedById  String?              @map("approved_by")
  approvedAt    DateTime?            @map("approved_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  vehicle       Vehicle              @relation(fields: [vehicleId], references: [id])
  trip          Trip?                @relation(fields: [tripId], references: [id])
  driver        Driver?              @relation(fields: [driverId], references: [id])
  createdBy     User?                @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy    User?                @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([vehicleId, expenseDate])
  @@index([tripId])
  @@index([driverId])
  @@index([status])
  @@map("expenses")
}

model Document {
  id                      String                   @id @default(cuid())
  documentNumber          String?                  @unique @map("document_number")
  title                   String
  description             String?
  originalFileName        String                   @map("original_file_name")
  storedFileName          String                   @map("stored_file_name")
  mimeType                String                   @map("mime_type")
  fileSizeBytes           Int                      @map("file_size_bytes")
  fileExtension           String?                  @map("file_extension")
  storageProvider         String                   @default("local") @map("storage_provider")
  storageBucket           String?                  @map("storage_bucket")
  storageKey              String                   @map("storage_key")
  checksumSha256          String?                  @map("checksum_sha256")

  documentType            DocumentType             @map("document_type")
  documentCategory        DocumentCategory         @map("document_category")
  linkedEntityType        LinkedEntityType?        @map("linked_entity_type")
  linkedEntityId          String?                  @map("linked_entity_id")

  vehicleId               String?                  @map("vehicle_id")
  driverId                String?                  @map("driver_id")
  tripId                  String?                  @map("trip_id")
  customerId              String?                  @map("customer_id")
  vendorId                String?                  @map("vendor_id")
  financeTransactionId    String?                  @map("finance_transaction_id")
  tripBillingId           String?                  @map("trip_billing_id")
  maintenanceRequestId    String?                  @map("maintenance_request_id")
  repairId                String?                  @map("repair_id")
  fuelEntryId             String?                  @map("fuel_entry_id")

  issueDate               DateTime?                @map("issue_date")
  expiryDate              DateTime?                @map("expiry_date")
  documentStatus          DocumentStatus           @default(ACTIVE) @map("document_status")
  verificationStatus      DocumentVerificationStatus @default(PENDING) @map("verification_status")
  tags                    String[]                 @default([])
  metadata                Json?

  uploadedById            String                   @map("uploaded_by_id")
  verifiedById            String?                  @map("verified_by_id")
  verifiedAt              DateTime?                @map("verified_at")
  archivedAt              DateTime?                @map("archived_at")
  deletedAt               DateTime?                @map("deleted_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  uploadedBy              User                     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  verifiedBy              User?                    @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  vehicle                 Vehicle?                 @relation(fields: [vehicleId], references: [id])
  driver                  Driver?                  @relation(fields: [driverId], references: [id])
  trip                    Trip?                    @relation(fields: [tripId], references: [id])
  customer                Customer?                @relation(fields: [customerId], references: [id])
  vendor                  Vendor?                  @relation(fields: [vendorId], references: [id])
  financeTransaction      FinanceTransaction?      @relation(fields: [financeTransactionId], references: [id])
  tripBilling             TripBilling?             @relation(fields: [tripBillingId], references: [id])
  maintenanceRequest      MaintenanceRequest?      @relation(fields: [maintenanceRequestId], references: [id])
  repair                  Repair?                  @relation(fields: [repairId], references: [id])
  fuelEntry               FuelEntry?               @relation("FuelLinkedDocuments", fields: [fuelEntryId], references: [id], onDelete: SetNull)

  @@index([documentNumber])
  @@index([documentType])
  @@index([documentCategory])
  @@index([linkedEntityType, linkedEntityId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([tripId])
  @@index([customerId])
  @@index([vendorId])
  @@index([expiryDate])
  @@index([uploadedById])
  @@index([documentStatus])
  @@index([verificationStatus])
  @@index([fuelEntryId])
  @@index([createdAt])
  @@map("documents")
}

model MaintenanceRequest {
  id              String               @id @default(cuid())
  vehicleId       String               @map("vehicle_id")
  tripId          String?              @map("trip_id")
  driverId        String?              @map("driver_id")
