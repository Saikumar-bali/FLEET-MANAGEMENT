generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String         @id @default(cuid())
  name          String
  username      String?        @unique
  email         String         @unique
  mobile        String?
  passwordHash  String         @map("password_hash")
  roleId        String         @map("role_id")
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  assetAssignmentsAssigned AssetAssignment[] @relation("AssetAssignmentAssignedBy")
  assetHistoriesCreated    AssetHistory[]    @relation("AssetHistoryCreatedBy")

  @@map("users")
}

model Role {
  id              String           @id @default(cuid())
  name            String
  key             String           @unique
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  status          RoleStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  UNDER_MAINTENANCE
  UNDER_REPAIR
  INACTIVE
  SOLD
  ACCIDENT
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

enum AssetCategoryStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  DAMAGED
  LOST
  UNDER_REPAIR
  RETIRED
}

enum AssetAssignmentHolderType {
  VEHICLE
  DRIVER
  USER
}

enum AssetAssignmentStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
  DAMAGED
  LOST
}

enum AssetHistoryAction {
  CREATED
  UPDATED
  ASSIGNED
  RETURNED
  TRANSFERRED
  DAMAGED
  LOST
  REPAIRED
  RETIRED
}

enum DocumentEntityType {
  VEHICLE
  DRIVER
  ASSET
}

model Vehicle {
  id              String        @id @default(cuid())
  vehicleNumber   String        @unique @map("vehicle_number")
  vehicleType     String        @map("vehicle_type")
  brand           String?
  model           String?
  year            Int?
  fuelType        String        @map("fuel_type")
  chassisNumber   String?       @unique @map("chassis_number")
  engineNumber    String?       @unique @map("engine_number")
  rcNumber        String?       @map("rc_number")
  insuranceExpiry DateTime?     @map("insurance_expiry")
  fitnessExpiry   DateTime?     @map("fitness_expiry")
  pollutionExpiry DateTime?     @map("pollution_expiry")
  permitExpiry    DateTime?     @map("permit_expiry")
  currentOdometer Int           @default(0) @map("current_odometer")
  status          VehicleStatus @default(AVAILABLE)
  currentDriverId String?       @map("current_driver_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  currentDriver   Driver?       @relation(fields: [currentDriverId], references: [id])

  @@map("vehicles")
}

model Driver {
  id                String       @id @default(cuid())
  name              String
  mobile            String       @unique
  alternateMobile   String?      @map("alternate_mobile")
  licenseNumber     String       @unique @map("license_number")
  licenseExpiry     DateTime?    @map("license_expiry")
  address           String?
  emergencyContact  String?      @map("emergency_contact")
  experienceYears   Int?         @map("experience_years")
  status            DriverStatus @default(AVAILABLE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  vehicles          Vehicle[]

  @@map("drivers")
}

model AssetCategory {
  id          String             @id @default(cuid())
  name        String
  key         String             @unique
  description String?
  status      AssetCategoryStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  assets      Asset[]

  @@map("asset_categories")
}

model Asset {
  id              String      @id @default(cuid())
  assetCode       String      @unique @map("asset_code")
  name            String
  assetCategoryId String      @map("asset_category_id")
  serialNumber    String?     @unique @map("serial_number")
  purchaseDate    DateTime?   @map("purchase_date")
  purchaseAmount  Decimal?    @map("purchase_amount")
  currentStatus   AssetStatus @default(AVAILABLE) @map("current_status")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  assetCategory   AssetCategory @relation(fields: [assetCategoryId], references: [id])
  assignments     AssetAssignment[]
  history         AssetHistory[]

  @@map("assets")
}

model AssetAssignment {
  id             String                    @id @default(cuid())
  assetId        String                    @map("asset_id")
  assignedToType AssetAssignmentHolderType @map("assigned_to_type")
  assignedToId   String                    @map("assigned_to_id")
  assignedById   String?                   @map("assigned_by_id")
  assignedAt     DateTime                  @default(now()) @map("assigned_at")
  returnedAt     DateTime?                 @map("returned_at")
  status         AssetAssignmentStatus     @default(ACTIVE)
  notes          String?
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  asset          Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedBy     User?                     @relation("AssetAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([assetId, status])
  @@map("asset_assignments")
}

model AssetHistory {
  id             String                    @id @default(cuid())
  assetId        String                    @map("asset_id")
  action         AssetHistoryAction
  fromHolderType AssetAssignmentHolderType? @map("from_holder_type")
  fromHolderId   String?                   @map("from_holder_id")
  toHolderType   AssetAssignmentHolderType? @map("to_holder_type")
  toHolderId     String?                   @map("to_holder_id")
  remarks        String?
  proofUrl       String?                   @map("proof_url")
  createdById    String?                   @map("created_by_id")
  createdAt      DateTime                  @default(now()) @map("created_at")
  asset          Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy      User?                     @relation("AssetHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@map("asset_history")
}

model Document {
  id             String             @id @default(cuid())
  entityType     DocumentEntityType @map("entity_type")
  entityId       String             @map("entity_id")
  documentType   String             @map("document_type")
  documentNumber String?            @map("document_number")
  expiryDate     DateTime?          @map("expiry_date")
  fileUrl        String?            @map("file_url")
  fileName       String?            @map("file_name")
  mimeType       String?            @map("mime_type")
  sizeBytes      Int?               @map("size_bytes")
  uploadedById   String?            @map("uploaded_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@map("documents")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
