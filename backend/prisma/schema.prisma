model VehicleComplianceDocument {
  id                  String              @id @default(cuid())
  vehicleId           String              @map("vehicle_id")
  complianceType      ComplianceType      @map("compliance_type")
  documentNumber      String?             @map("document_number")
  validFrom           DateTime?           @map("valid_from")
  validTo             DateTime?           @map("valid_to")
  issuingAuthority    String?             @map("issuing_authority")
  externalFileUrl     String?             @map("external_file_url")
  fileName            String?             @map("file_name")
  mimeType            String?             @map("mime_type")
  sizeBytes           Int?                @map("size_bytes")
  verifiedById        String?             @map("verified_by_id")
  verifiedAt          DateTime?           @map("verified_at")
  status              ComplianceDocStatus @default(DRAFT)
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  vehicle             Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  verifiedBy          User?               @relation("ComplianceDocVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([complianceType])
  @@index([validTo])
  @@index([status])
  @@map("vehicle_compliance_documents")
}

model VehicleComplianceHistory {
  id              String                  @id @default(cuid())
  vehicleId       String                  @map("vehicle_id")
  complianceType  ComplianceType          @map("compliance_type")
  entityType      String                  @map("entity_type")
  entityId        String?                 @map("entity_id")
  action          ComplianceHistoryAction
  fromStatus      String?                 @map("from_status")
  toStatus        String?                 @map("to_status")
  oldValues       Json?                   @map("old_values")
  newValues       Json?                   @map("new_values")
  remarks         String?
  createdById     String?                 @map("created_by_id")
  createdAt       DateTime                @default(now()) @map("created_at")
  vehicle         Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy       User?                   @relation("ComplianceHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([vehicleId, createdAt])
  @@index([complianceType])
  @@index([action])
  @@map("vehicle_compliance_history")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
