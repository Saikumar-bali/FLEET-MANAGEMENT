  collectedByDriverId   String?             @map("collected_by_driver_id")
  reconciledStatus      String?             @default("UNRECONCILED") @map("reconciled_status")
  reconciledAt          DateTime?           @map("reconciled_at")
  referenceNumber       String?             @map("reference_number")
  notes                 String?
  createdById           String?             @map("created_by_id")
  createdAt             DateTime            @default(now()) @map("created_at")
  transaction           FinanceTransaction? @relation(fields: [transactionId], references: [id])
  tripBilling           TripBilling?        @relation(fields: [tripBillingId], references: [id])
  account               FinanceAccount?     @relation(fields: [accountId], references: [id])
  vendor                Vendor?             @relation(fields: [vendorId], references: [id])
  customer              Customer?           @relation(fields: [customerId], references: [id])
  createdBy             User?               @relation("PaymentRecordCreatedBy", fields: [createdById], references: [id])

  @@index([transactionId])
  @@index([tripBillingId])
  @@index([paymentDate])
  @@index([paymentNumber])
  @@map("payment_records")
}

model FinanceHistory {
  id          String                  @id @default(cuid())
  entityType  FinanceHistoryEntityType @map("entity_type")
  entityId    String                  @map("entity_id")
  action      FinanceHistoryAction
  oldValues   Json?                   @map("old_values")
  newValues   Json?                   @map("new_values")
  remarks     String?
  createdById String?                 @map("created_by_id")
  createdAt   DateTime                @default(now()) @map("created_at")
  createdBy   User?                   @relation("FinanceHistoryCreatedBy", fields: [createdById], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("finance_history")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
