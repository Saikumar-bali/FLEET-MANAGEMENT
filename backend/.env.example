PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/database?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/database?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ENABLE_DEMO_USERS=false
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Demo Users (requires ENABLE_DEMO_USERS=true, not allowed in production)
# Username          Password            Role
# admin             admin@123           super_admin (created via ADMIN_EMAIL/ADMIN_USERNAME)
# opsadmin          opsadmin@123        admin
# manager           manager@123         manager
# supervisor        supervisor@123      supervisor
# driver            driver@123          driver
# assistantdriver   assistant@123       assistant_driver
# collector         collector@123       collector
# mechanic          mechanic@123        mechanic
# finance           finance@123         finance
# viewer            viewer@123          viewer

# Storage configuration (local for dev, s3/R2 for production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=.storage/uploads
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_EXPIRES_SECONDS=900

# Playwright E2E test user (for user-access-management.spec.ts)
# The test creates/resets PHASE_ACCESS_UI_TEST_USER with these credentials.
# E2E_ALLOW_TEST_USER_MUTATION=true must be set to allow automatic creation/reset.
# E2E_ALLOW_REMOTE_TEST_MUTATION=true is required for non-local API bases.
E2E_ACCESS_TEST_IDENTIFIER=phase_access_ui_test_user@test.local
E2E_ACCESS_TEST_PASSWORD=replace-with-a-strong-test-password
E2E_ALLOW_TEST_USER_MUTATION=false
E2E_ALLOW_REMOTE_TEST_MUTATION=false
