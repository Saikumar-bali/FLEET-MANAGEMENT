{
  "name": "fleet-management-backend",
  "version": "1.0.0",
  "description": "Fleet Management Platform - Backend API",
  "main": "dist/src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon --exec ts-node --files src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "lint": "tsc --noEmit",
    "smoke:test": "ts-node scripts/smoke-test.ts",
    "test:trips": "ts-node scripts/trip-workflow-test.ts",
    "test:fuel-expenses": "ts-node scripts/fuel-expense-workflow-test.ts",
    "test:maintenance-repair": "ts-node scripts/maintenance-repair-workflow-test.ts",
    "test:vehicle-compliance": "ts-node scripts/vehicle-compliance-workflow-test.ts",
    "test:api-docs": "ts-node scripts/api-docs-coverage-test.ts",
    "test:staging-api": "ts-node scripts/staging-api-smoke-test.ts",
    "test:fuel-expenses:staging": "ts-node scripts/fuel-expense-staging-test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "prisma db seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
