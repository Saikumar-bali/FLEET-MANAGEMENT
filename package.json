{
  "name": "fleet-management",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "tsx backend/src/server.ts",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:lint": "npm --prefix backend run lint",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:lint": "npm --prefix web run lint",
    "build": "npm run backend:build && npm run web:build",
    "lint": "npm run backend:lint && npm run web:lint",
    "start": "node backend/dist/src/server.js"
  }
}
